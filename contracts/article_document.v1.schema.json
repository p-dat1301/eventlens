{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Unicode code-point half-open range in one normalized content revision.",
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "end_offset": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "End Offset",
          "type": "integer"
        },
        "excerpt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Excerpt",
          "type": "string"
        },
        "offset_basis": {
          "const": "unicode_codepoint",
          "title": "Offset Basis",
          "type": "string"
        },
        "span_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Span Fingerprint",
          "type": "string"
        },
        "span_id": {
          "format": "uuid",
          "title": "Span Id",
          "type": "string"
        },
        "start_offset": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        }
      },
      "required": [
        "span_id",
        "article_id",
        "content_hash",
        "start_offset",
        "end_offset",
        "excerpt",
        "span_fingerprint",
        "offset_basis"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Searchable NFC content plus immutable original-source provenance.",
  "properties": {
    "article_id": {
      "format": "uuid",
      "title": "Article Id",
      "type": "string"
    },
    "canonical_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Canonical Url",
      "type": "string"
    },
    "content_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Fingerprint",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "evidence_spans": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Evidence Spans",
      "type": "array"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "normalization_version": {
      "const": "nfc.v1",
      "title": "Normalization Version",
      "type": "string"
    },
    "normalized_content": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Normalized Content",
      "type": "string"
    },
    "processed_at": {
      "format": "date-time",
      "title": "Processed At",
      "type": "string"
    },
    "raw_content": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Raw Content",
      "type": "string"
    },
    "schema_version": {
      "const": "article_document.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_domain": {
      "pattern": "^[a-z0-9.-]+$",
      "title": "Source Domain",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "source_name": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Name",
      "type": "string"
    },
    "source_published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Published At"
    },
    "title": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "visibility": {
      "const": "internal",
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "source_id",
    "title",
    "raw_content",
    "normalization_version",
    "normalized_content",
    "canonical_url",
    "source_name",
    "source_domain",
    "source_published_at",
    "ingested_at",
    "processed_at",
    "content_hash",
    "content_fingerprint",
    "visibility",
    "evidence_spans"
  ],
  "title": "ArticleDocument",
  "type": "object"
}
