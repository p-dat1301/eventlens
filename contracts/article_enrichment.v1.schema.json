{
  "$defs": {
    "EnrichedEntity": {
      "additionalProperties": false,
      "description": "Evidence-backed canonical entity extraction.",
      "properties": {
        "canonical_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "entity_type": {
          "enum": [
            "LOCATION",
            "ORG",
            "PERSON",
            "SERVICE",
            "PRODUCT",
            "FACILITY",
            "OTHER"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_span_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "surface_forms": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Surface Forms",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_name",
        "surface_forms",
        "evidence_span_ids",
        "confidence"
      ],
      "title": "EnrichedEntity",
      "type": "object"
    },
    "EnrichedLocation": {
      "additionalProperties": false,
      "description": "Evidence-backed canonical location extraction.",
      "properties": {
        "canonical_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_span_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Location Id"
        },
        "location_type": {
          "enum": [
            "country",
            "region",
            "city",
            "district",
            "facility",
            "other"
          ],
          "title": "Location Type",
          "type": "string"
        },
        "surface_forms": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Surface Forms",
          "type": "array"
        }
      },
      "required": [
        "location_id",
        "location_type",
        "canonical_name",
        "surface_forms",
        "evidence_span_ids",
        "confidence"
      ],
      "title": "EnrichedLocation",
      "type": "object"
    },
    "EnrichmentStatus": {
      "description": "Persisted lifecycle status for one immutable enrichment identity.",
      "enum": [
        "PENDING",
        "PROCESSING",
        "READY",
        "FAILED",
        "STALE"
      ],
      "title": "EnrichmentStatus",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Unicode code-point half-open range in one normalized content revision.",
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "end_offset": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "End Offset",
          "type": "integer"
        },
        "excerpt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Excerpt",
          "type": "string"
        },
        "offset_basis": {
          "const": "unicode_codepoint",
          "title": "Offset Basis",
          "type": "string"
        },
        "span_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Span Fingerprint",
          "type": "string"
        },
        "span_id": {
          "format": "uuid",
          "title": "Span Id",
          "type": "string"
        },
        "start_offset": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        }
      },
      "required": [
        "span_id",
        "article_id",
        "content_hash",
        "start_offset",
        "end_offset",
        "excerpt",
        "span_fingerprint",
        "offset_basis"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FieldConfidence": {
      "additionalProperties": false,
      "description": "Immutable confidence for one controlled enrichment field.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "field": {
          "enum": [
            "topics",
            "content_type",
            "event_relevance",
            "entities",
            "locations"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "confidence"
      ],
      "title": "FieldConfidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, versioned enrichment result for one article content revision.",
  "properties": {
    "article_id": {
      "format": "uuid",
      "title": "Article Id",
      "type": "string"
    },
    "attempt_count": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "content_type": {
      "anyOf": [
        {
          "enum": [
            "news_report",
            "analysis",
            "opinion",
            "press_release",
            "interview",
            "fact_check",
            "live_update",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Type"
    },
    "enriched_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Enriched At"
    },
    "enrichment_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Enrichment Version",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EnrichedEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "event_relevance": {
      "anyOf": [
        {
          "enum": [
            "actionable_event",
            "background",
            "follow_up",
            "no_actionable_event",
            "uncertain"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Event Relevance"
    },
    "evidence_spans": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Evidence Spans",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Code"
    },
    "field_confidence": {
      "items": {
        "$ref": "#/$defs/FieldConfidence"
      },
      "title": "Field Confidence",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/EnrichedLocation"
      },
      "title": "Locations",
      "type": "array"
    },
    "model_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model Version",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "const": "article_enrichment.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EnrichmentStatus"
    },
    "suggested_tags": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Suggested Tags",
      "type": "array"
    },
    "topics": {
      "items": {
        "enum": [
          "business",
          "technology",
          "politics",
          "economy",
          "public_safety",
          "weather",
          "transportation",
          "health",
          "energy",
          "environment",
          "other"
        ],
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "content_hash",
    "enrichment_version",
    "model_version",
    "prompt_version",
    "status",
    "topics",
    "content_type",
    "event_relevance",
    "entities",
    "locations",
    "suggested_tags",
    "evidence_spans",
    "field_confidence",
    "enriched_at",
    "attempt_count",
    "failure_code"
  ],
  "title": "ArticleEnrichment",
  "type": "object"
}
