{
  "$defs": {
    "ArticleDocument": {
      "additionalProperties": false,
      "description": "Searchable NFC content plus immutable original-source provenance.",
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "canonical_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "content_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Fingerprint",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence Spans",
          "type": "array"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "normalization_version": {
          "const": "nfc.v1",
          "title": "Normalization Version",
          "type": "string"
        },
        "normalized_content": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Normalized Content",
          "type": "string"
        },
        "processed_at": {
          "format": "date-time",
          "title": "Processed At",
          "type": "string"
        },
        "raw_content": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Raw Content",
          "type": "string"
        },
        "schema_version": {
          "const": "article_document.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_domain": {
          "pattern": "^[a-z0-9.-]+$",
          "title": "Source Domain",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Name",
          "type": "string"
        },
        "source_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Published At"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "visibility": {
          "const": "internal",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "article_id",
        "source_id",
        "title",
        "raw_content",
        "normalization_version",
        "normalized_content",
        "canonical_url",
        "source_name",
        "source_domain",
        "source_published_at",
        "ingested_at",
        "processed_at",
        "content_hash",
        "content_fingerprint",
        "visibility",
        "evidence_spans"
      ],
      "title": "ArticleDocument",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Claim-bound pointer to immutable source evidence.",
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "citation_id": {
          "format": "uuid",
          "title": "Citation Id",
          "type": "string"
        },
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_span_id": {
          "format": "uuid",
          "title": "Evidence Span Id",
          "type": "string"
        },
        "source_reference": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "source_title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Title",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "claim_id",
        "article_id",
        "evidence_span_id",
        "source_title",
        "source_reference"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One material factual proposition with optional occurrence-time claim.",
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "temporal_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "temporal_claim"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimDisplayBlock": {
      "additionalProperties": false,
      "description": "Display one validated claim exactly once.",
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "const": "claim",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "claim_id"
      ],
      "title": "ClaimDisplayBlock",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Unicode code-point half-open range in one normalized content revision.",
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "end_offset": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "End Offset",
          "type": "integer"
        },
        "excerpt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Excerpt",
          "type": "string"
        },
        "offset_basis": {
          "const": "unicode_codepoint",
          "title": "Offset Basis",
          "type": "string"
        },
        "span_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Span Fingerprint",
          "type": "string"
        },
        "span_id": {
          "format": "uuid",
          "title": "Span Id",
          "type": "string"
        },
        "start_offset": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        }
      },
      "required": [
        "span_id",
        "article_id",
        "content_hash",
        "start_offset",
        "end_offset",
        "excerpt",
        "span_fingerprint",
        "offset_basis"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "TemporalClaim": {
      "additionalProperties": false,
      "description": "Known temporal value or explicit unknown, always evidence-backed.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "end_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End At"
        },
        "evidence_span_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "precision": {
          "enum": [
            "minute",
            "hour",
            "day",
            "month",
            "year",
            "unknown"
          ],
          "title": "Precision",
          "type": "string"
        },
        "reference_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference At"
        },
        "relative_expression": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Expression"
        },
        "start_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start At"
        },
        "timezone_basis": {
          "anyOf": [
            {
              "const": "UTC",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone Basis"
        },
        "value_state": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Value State",
          "type": "string"
        }
      },
      "required": [
        "value_state",
        "start_at",
        "end_at",
        "precision",
        "confidence",
        "evidence_span_ids",
        "relative_expression",
        "reference_at",
        "timezone_basis"
      ],
      "title": "TemporalClaim",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Explicit evidence limitation or abstention reason.",
      "properties": {
        "category": {
          "enum": [
            "insufficient_evidence",
            "ambiguity",
            "source_conflict",
            "temporal_uncertainty"
          ],
          "title": "Category",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "uncertainty_id": {
          "format": "uuid",
          "title": "Uncertainty Id",
          "type": "string"
        }
      },
      "required": [
        "uncertainty_id",
        "category",
        "explanation"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "UncertaintyDisplayBlock": {
      "additionalProperties": false,
      "description": "Display one validated uncertainty exactly once.",
      "properties": {
        "kind": {
          "const": "uncertainty",
          "title": "Kind",
          "type": "string"
        },
        "uncertainty_id": {
          "format": "uuid",
          "title": "Uncertainty Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uncertainty_id"
      ],
      "title": "UncertaintyDisplayBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Grounded answer rendered only from validated claim and uncertainty blocks.",
  "properties": {
    "answer": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Answer",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "display_blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "claim": "#/$defs/ClaimDisplayBlock",
            "uncertainty": "#/$defs/UncertaintyDisplayBlock"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ClaimDisplayBlock"
          },
          {
            "$ref": "#/$defs/UncertaintyDisplayBlock"
          }
        ]
      },
      "title": "Display Blocks",
      "type": "array"
    },
    "index_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Index Version",
      "type": "string"
    },
    "model_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model Version",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "briefing_answer.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_documents": {
      "items": {
        "$ref": "#/$defs/ArticleDocument"
      },
      "title": "Source Documents",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "$ref": "#/$defs/Uncertainty"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "claims",
    "citations",
    "uncertainties",
    "display_blocks",
    "answer",
    "source_documents",
    "retrieved_at",
    "model_version",
    "index_version"
  ],
  "title": "BriefingAnswer",
  "type": "object"
}
