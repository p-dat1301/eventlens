{
  "additionalProperties": false,
  "description": "Bounded analyst request over source-publication time.",
  "properties": {
    "context_budget": {
      "maximum": 12000,
      "minimum": 1,
      "title": "Context Budget",
      "type": "integer"
    },
    "entity_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "publication_time_basis": {
      "const": "source_published_at",
      "title": "Publication Time Basis",
      "type": "string"
    },
    "published_after": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published After"
    },
    "published_before": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published Before"
    },
    "query": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Query",
      "type": "string"
    },
    "result_limit": {
      "maximum": 100,
      "minimum": 1,
      "title": "Result Limit",
      "type": "integer"
    },
    "schema_version": {
      "const": "briefing_query.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_domains": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9.-]+$",
        "type": "string"
      },
      "title": "Source Domains",
      "type": "array"
    },
    "topic_filters": {
      "default": [],
      "items": {
        "enum": [
          "business",
          "technology",
          "politics",
          "economy",
          "public_safety",
          "weather",
          "transportation",
          "health",
          "energy",
          "environment",
          "other"
        ],
        "type": "string"
      },
      "title": "Topic Filters",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "query",
    "publication_time_basis",
    "result_limit",
    "context_budget"
  ],
  "title": "BriefingQuery",
  "type": "object"
}
