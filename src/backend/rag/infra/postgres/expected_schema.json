 "views": [
  [
   "rag_current_lexical",
   " SELECT document.article_id,\n    document.content_hash,\n    document.source_id,\n    document.title,\n    document.normalized_content,\n    document.source_published_at,\n    document.tombstoned_at,\n    document.search_vector,\n    document.created_at,\n    document.document_json\n   FROM rag_article_documents document\n     JOIN rag_article_current current USING (article_id, content_hash)\n  WHERE current.tombstoned_at IS NULL;"
  ],
  [
   "rag_current_vectors",
   " SELECT chunk.chunk_id,\n    chunk.article_id,\n    chunk.content_hash,\n    chunk.generation,\n    chunk.chunk_index,\n    chunk.start_offset,\n    chunk.end_offset,\n    chunk.content,\n    chunk.fingerprint,\n    chunk.embedding\n   FROM rag_chunks chunk\n     JOIN rag_article_current current ON current.article_id = chunk.article_id AND current.content_hash = chunk.content_hash AND current.active_index_generation = chunk.generation\n     JOIN rag_index_generations generation ON generation.generation = chunk.generation\n  WHERE current.tombstoned_at IS NULL AND generation.status = 'ACTIVE'::text;"
  ]
 ],
