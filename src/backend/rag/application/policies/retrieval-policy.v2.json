{
  "schema_version": "retrieval_policy.v2",
  "policy_id": "retrieval-policy.v2",
  "supersedes": "retrieval-policy.v1",
  "change_reason": "T5 independent review 2026-10-18: R3 query terms were Python-casefolded and missed PostgreSQL 'simple' lexemes (Straße); R4 lexical chunk work was unbounded for long articles; R1 adds access re-checks after the final fetch and before return. v1 evidence is invalidated and was re-run under v2.",
  "fusion_policy_id": "rrf-k60.v1",
  "rationale": "Fixture/dev policy frozen before T5 measurement. Values come from the D35/D43 caps and from labeled fixture dev pairs (01/22 duplicate wire copy = 0.78 word-3-shingle Jaccard; 03/04 conflicting capacity claims = 0.33). No value was tuned on held-out results; T9 owns the full evaluation gate.",
  "query_clock": "injected_wall_clock_read_once_per_query",
  "chunker_version": "codepoint-1200-200.v1",
  "normalization_version": "nfc.v1",
  "tokenizer": {
    "tokenizer_id": "postgres-simple-lexemes.v2",
    "source": "to_tsvector_simple_of_nfc_query",
    "chunk_terms": "to_tsvector_simple_of_title_plus_chunk",
    "term_order": "first_position_then_lexeme",
    "max_query_terms": 32,
    "fts_config": "simple",
    "tsquery_operator": "or",
    "stopwords": [
      "a",
      "about",
      "an",
      "and",
      "any",
      "are",
      "as",
      "at",
      "be",
      "by",
      "did",
      "do",
      "does",
      "for",
      "from",
      "has",
      "have",
      "how",
      "in",
      "is",
      "it",
      "of",
      "on",
      "or",
      "the",
      "to",
      "was",
      "were",
      "what",
      "when",
      "where",
      "which",
      "who",
      "why",
      "with"
    ]
  },
  "filters": {
    "order": [
      "caller_access",
      "publication_range",
      "metadata_eligibility",
      "current_revision_source_time_in_each_branch",
      "caller_access_before_final_fetch",
      "final_current_access_metadata_check",
      "caller_access_after_final_fetch",
      "caller_access_before_return"
    ],
    "publication_field": "source_published_at",
    "published_after": "inclusive",
    "published_before": "exclusive",
    "equal_bounds": "empty_range",
    "null_publication_time": "excluded_when_any_bound_set",
    "topic_semantics": "any_of_requested_topics",
    "entity_semantics": "any_of_requested_entity_ids",
    "across_filter_kinds": "all_of",
    "metadata_source": "valid_ready_publication_for_current_revision_and_active_generation",
    "metadata_scan_cap": 5000
  },
  "lexical": {
    "article_pool": 50,
    "max_chunks_scanned_per_article": 40,
    "chunk_pool": 150,
    "depth": 50,
    "max_chunks_per_article": 3,
    "scan_limit_exceeded": "report_lexical_truncated_articles_never_widen",
    "chunk_score": "distinct_query_lexemes_in_title_plus_chunk_div_query_lexemes",
    "ties": "score_desc,document_rank_desc,source_published_at_desc_nulls_last,article_id_asc,chunk_id_asc"
  },
  "vector": {
    "route": "exact",
    "pool": 100,
    "depth": 50,
    "max_chunks_per_article": 3,
    "chunk_score": "cosine_similarity",
    "ties": "score_desc,source_published_at_desc_nulls_last,article_id_asc,chunk_id_asc",
    "ann_enabled": false,
    "ann_note": "HNSW iterative scan is measured separately (vector-route-report) and stays disabled until recall/latency are proven on representative data."
  },
  "freshness": {
    "function": "branch_score + weight * 0.5 ** (age_days / half_life_days)",
    "half_life_days": 30.0,
    "weight": 0.05,
    "missing_timestamp": "no_boost",
    "future_timestamp": "no_boost",
    "applies_to": "branch_score_before_branch_rank_assignment"
  },
  "rrf": {
    "k": 60,
    "formula": "sum(1 / (k + rank_b))",
    "missing_branch_contribution": 0,
    "ties": "fused_score_desc,source_published_at_desc_nulls_last,article_id_asc,chunk_id_asc"
  },
  "dedup": {
    "stage": "after_fusion_before_rerank",
    "exact_fingerprint": "sha256(casefold(nfc(text)) with whitespace collapsed)",
    "near_duplicate": "word_shingle_jaccard",
    "shingle_size": 3,
    "near_duplicate_threshold": 0.7,
    "near_duplicate_scope": "cross_article",
    "representative": "earliest_source_published_at_nulls_last,article_id_asc,chunk_id_asc",
    "cluster_score": "max_member_fused_score",
    "note": "Near-duplicate suppression is not story grouping or canonical event merging."
  },
  "rerank": {
    "max_candidates": 40,
    "max_tokens_per_candidate": 512,
    "timeout_seconds": 1.5,
    "beyond_window": "appended_in_fused_order",
    "missing_ids": "invalid",
    "unknown_ids": "invalid",
    "duplicate_ids": "invalid",
    "non_finite_scores": "invalid",
    "ties": "rerank_score_desc,fused_score_desc,source_published_at_desc_nulls_last,article_id_asc,chunk_id_asc",
    "malformed_output": "invalid"
  },
  "aggregation": {
    "article_order": "best_chunk_position_after_rerank",
    "max_spans_per_article": 3,
    "span_order": "reranked_order",
    "final_check_pool_multiplier": 2,
    "final_check_offsets": "chunk_arithmetic_no_rechunking"
  },
  "output": {
    "max_articles": 20,
    "max_context_tokens": 12000,
    "min_truncated_span_tokens": 16,
    "context_format": "evidence-context-jsonl.v1",
    "budget_exhausted": "stop_at_first_span_that_does_not_fit_after_truncation"
  }
}
