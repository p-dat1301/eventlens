    "method": "POST",
    "roles": ["system", "user"],
    "response_format": "json_schema_strict",
    "output_token_field": "max_tokens",
    "temperature": 0,
    "usage_mapping": "prompt_tokens->input,completion_tokens->output",
    "success_finish_reason": "stop",
    "follow_redirects": false,
    "tls_verify": true,
    "trust_env_proxy": false,
    "client_retries": 0
  },
  "budget": {
    "synthesis_policy_id": "synthesis-policy.v1",
